# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 2
indent_style = space
insert_final_newline = true
max_line_length = 80
trim_trailing_whitespace = true

[*.{mts,ts}]
indent_size = 4
max_line_length = 100

[compose.yml]
max_line_length = 120

[*.md]
max_line_length = 320

[*.sql]
indent_size = 4
max_line_length = 120
