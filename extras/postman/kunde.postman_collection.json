{
  "info": {
    "name": "Kundenverwaltung (Hono, HTTP/2)",
    "description": "REST-Schnittstelle des Appservers. Zuerst \"01 Token\" ausfuehren, \"03 Schreiben\" in der angegebenen Reihenfolge.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://localhost:3000"
    },
    {
      "key": "restUrl",
      "value": "https://localhost:3000/rest/kunden"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "tokenUser",
      "value": ""
    },
    {
      "key": "kundeId",
      "value": ""
    },
    {
      "key": "email",
      "value": ""
    },
    {
      "key": "etag20",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Token",
      "item": [
        {
          "name": "Token fuer admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/token",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"p\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"token\", pm.response.json().access_token);"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "strictSSL": false,
            "disableBodyPruning": true
          }
        },
        {
          "name": "Token fuer user (ohne Rolle admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/token",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"user\",\n  \"password\": \"p\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"tokenUser\", pm.response.json().access_token);"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "strictSSL": false,
            "disableBodyPruning": true
          }
        }
      ]
    },
    {
      "name": "02 Lesen",
      "item": [
        {
          "name": "GET Kunde mit ID (Pfadparameter)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{restUrl}}/20",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"ETag mit Version\", () => pm.expect(pm.response.headers.get(\"ETag\")).to.match(/^\"\\d+\"$/));",
                  "pm.test(\"Adresse (1:1) und Bestellungen (1:N)\", () => { const k = pm.response.json(); pm.expect(k.adresse.plz).to.match(/^\\d{5}$/); pm.expect(k.bestellungen).to.be.an(\"array\"); });",
                  "pm.collectionVariables.set(\"etag20\", pm.response.headers.get(\"ETag\"));"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "strictSSL": false,
            "disableBodyPruning": true
          }
        },
        {
          "name": "GET mit If-None-Match (304)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "If-None-Match",
                "value": "{{etag20}}"
              }
            ],
            "url": "{{restUrl}}/20",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 304 Not Modified\", () => pm.response.to.have.status(304));"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "strictSSL": false,
            "disableBodyPruning": true
          }
        },
        {
          "name": "GET mit Query-Parametern und Pagination",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{restUrl}}?plz=7&page=1&size=2",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Seite mit 2 Kunden\", () => { const p = pm.response.json(); pm.expect(p.content).to.have.lengthOf(2); pm.expect(p.page.number).to.equal(1); });"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "strictSSL": false,
            "disableBodyPruning": true
          }
        },
        {
          "name": "GET mit Teil des Nachnamens",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{restUrl}}?nachname=er",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test(\"Status 200\", () => pm.response.to.have.status(200));"]
              }
            }
          ],
          "protocolProfileBehavior": {
            "strictSSL": false,
            "disableBodyPruning": true
          }
        },
        {
          "name": "QUERY mit Suchkriterien im Body",
          "request": {
            "method": "QUERY",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{restUrl}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ort\": \"Karlsruhe\",\n  \"page\": 1,\n  \"size\": 5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"nur Kunden aus Karlsruhe\", () => pm.response.json().content.forEach((k) => pm.expect(k.adresse.ort).to.equal(\"Karlsruhe\")));"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "strictSSL": false,
            "disableBodyPruning": true
          }
        }
      ]
    },
    {
      "name": "03 Schreiben (Reihenfolge einhalten)",
      "item": [
        {
          "name": "POST neuer Kunde (admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{restUrl}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nachname\": \"Postman\",\n  \"vorname\": \"Paula\",\n  \"email\": \"{{email}}\",\n  \"geburtsdatum\": \"1997-07-07\",\n  \"adresse\": {\n    \"strasse\": \"Moltkestrasse\",\n    \"hausnummer\": \"30\",\n    \"plz\": \"76133\",\n    \"ort\": \"Karlsruhe\"\n  },\n  \"bestellungen\": [\n    {\n      \"produktname\": \"Monitor\",\n      \"menge\": 2,\n      \"preis\": 179.9\n    },\n    {\n      \"produktname\": \"Kabel\",\n      \"menge\": 3,\n      \"preis\": 4.99\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.collectionVariables.set(\"email\", `paula.${Date.now()}@acme.de`);"]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201 Created\", () => pm.response.to.have.status(201));",
                  "const location = pm.response.headers.get(\"Location\");",
                  "pm.test(\"Header Location\", () => pm.expect(location).to.match(/\\/rest\\/kunden\\/\\d+$/));",
                  "pm.collectionVariables.set(\"kundeId\", location.split(\"/\").pop());"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "strictSSL": false,
            "disableBodyPruning": true
          }
        },
        {
          "name": "GET neuer Kunde",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{restUrl}}/{{kundeId}}",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Version 0\", () => pm.expect(pm.response.json().version).to.equal(0));"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "strictSSL": false,
            "disableBodyPruning": true
          }
        },
        {
          "name": "PUT mit If-Match \"0\"",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "If-Match",
                "value": "\"0\""
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{restUrl}}/{{kundeId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nachname\": \"Postman-Geaendert\",\n  \"vorname\": \"Paula\",\n  \"email\": \"{{email}}\",\n  \"geburtsdatum\": \"1997-07-07\",\n  \"adresse\": {\n    \"strasse\": \"Kaiserstrasse\",\n    \"hausnummer\": \"1\",\n    \"plz\": \"76131\",\n    \"ort\": \"Karlsruhe\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 204 No Content\", () => pm.response.to.have.status(204));",
                  "pm.test(\"neuer ETag \\\"1\\\"\", () => pm.expect(pm.response.headers.get(\"ETag\")).to.equal('\"1\"'));"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "strictSSL": false,
            "disableBodyPruning": true
          }
        },
