meta {
  name: Token fuer user (ohne Rolle admin)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auth/token
  body: json
  auth: none
}

body:json {
  {
    "username": "user",
    "password": "p"
  }
}

script:post-response {
  bru.setVar("tokenUser", res.body.access_token);
}

tests {
  test("Status 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}
