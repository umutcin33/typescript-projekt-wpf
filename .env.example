# Vorlage fuer .env (kopieren: Copy-Item .env.example .env)
# .env wird von "node --env-file=.env" und von drizzle-kit gelesen.

NODE_ENV=development
LOG_LEVEL=debug

# DB-Verbindung fuer drizzle-kit (pull / studio); Host-Port 5434 siehe extras/compose/compose.yml
DATABASE_URL=postgresql://kunde:p@localhost:5434/kunde

# Passwort des DB-Users "kunde" fuer den Appserver
DB_PASSWORD=p

# Client Secret von "kunde-client" (siehe extras/compose/keycloak/realm/kunde-realm.json)
CLIENT_SECRET=i7Q2rTMwWzuOZ6WHA-G-i_XZfT5oIjjQ
