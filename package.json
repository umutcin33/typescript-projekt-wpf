{
  "name": "kunde",
  "version": "2026.11.1",
  "private": true,
  "description": "REST-Appserver fuer Kunden mit Hono, Drizzle, PostgreSQL und Keycloak",
  "keywords": [
    "Drizzle",
    "HTTP2",
    "Hono",
    "Keycloak",
    "Oxfmt",
    "Oxlint",
    "Pino",
    "PostgreSQL",
    "REST",
    "TypeScript",
    "Vitest",
    "Zod",
    "pnpm"
  ],
  "license": "GPL-3.0",
  "author": "Umut Cin",
  "type": "module",
  "scripts": {
    "start": "node --env-file=.env src/index.mts",
    "dev": "node --env-file=.env --watch src/index.mts",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "tsc": "tsc --noEmit --pretty",
    "db:pull": "drizzle-kit pull",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@hono/node-server": "2.1.6",
    "drizzle-orm": "1.0.0-rc.5",
    "hono": "5.0.0-rc.0",
    "jose": "6.2.15",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-pretty": "13.2.0",
    "smol-toml": "1.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "5.10.0",
    "@tsconfig/node-ts": "23.6.4",
    "@tsconfig/node26": "26.0.1",
    "@tsconfig/strictest": "2.0.8",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "axios": "1.21.0",
    "drizzle-kit": "1.0.0-rc.5",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0",
    "typescript": "7.1.0-beta",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.21.0",
      "onFail": "warn"
    },
    "runtime": {
      "name": "node",
      "version": "^26.13.1",
      "onFail": "warn"
    }
  },
  "engines": {
    "node": "^26.13.1",
    "pnpm": "^12.21.0"
  }
}
